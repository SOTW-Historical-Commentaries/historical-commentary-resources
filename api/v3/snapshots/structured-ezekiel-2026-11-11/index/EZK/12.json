      {
        "section_id": "nav:keil-delitzsch:EZK.12:P:declarations-to-remove-all-doubt-as-to-the-truth-of-the-threat",
        "navigation_id": "EZK.12:P:declarations-to-remove-all-doubt-as-to-the-truth-of-the-threat",
        "scope": "passage",
